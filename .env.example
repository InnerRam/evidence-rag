# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PROXY_NETWORK=proxy_network

# Storage (Compose value; local mock can use sqlite:///./evidence_rag.db)
POSTGRES_DB=evidence_rag
POSTGRES_USER=evidence_rag
POSTGRES_PASSWORD=change-me-before-deploying
DATABASE_URL=postgresql+psycopg://evidence_rag:change-me-before-deploying@db:5432/evidence_rag
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760

# Retrieval
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
DEFAULT_TOP_K=5
MAX_TOP_K=10
MIN_EVIDENCE_SCORE=0.18
MIN_LEXICAL_COVERAGE=0.35

# Provider abstraction: mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini
EMBEDDING_DIMENSIONS=1536

# Optional cost model (USD per 1M tokens). Set to current account/model rates.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
OPENAI_EMBEDDING_USD_PER_MILLION=0
